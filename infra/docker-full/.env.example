# Copy this file to .env and fill in your values
# cp .env.example .env

# Database Configuration
POSTGRES_USER=bithave_user
POSTGRES_PASSWORD=bithave_password
POSTGRES_DB=bithave_db

# Application Port (access frontend at http://localhost:4200)
APP_PORT=4200

# CoinGecko API (for BTC price) - get your key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here

# BTCPay Server Configuration
BTCPAY_URL=http://your-btcpay-server:23001
BTCPAY_STORE_ID=your_store_id_here
BTCPAY_API_TOKEN=your_api_token_here

# Shared secret for the BTCPay webhook, must match the one configured in the BTCPay store
BTCPAY_WEBHOOK_SECRET=

# Public base URL of the shop, used as the BTCPay return target
APP_BASE_URL=http://localhost:4200
